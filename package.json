{
  "name": "@otohime-site/parser",
  "version": "26.11.0",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/otohime-site/parser#readme",
  "repository": "github:otohime-site/parser",
  "sideEffects": false,
  "exports": {
    "./dx_intl": "./dx_intl/index.js"
  },
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "lint": "eslint",
    "test": "vitest run --coverage",
    "build": "rm -rf dist/ && tsc && cp README.md dist/ && jq 'del(.scripts.prepare)' package.json > dist/package.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.js,*.ts": "eslint --cache --fix",
    "*.{js,ts,css,md}": "prettier --write"
  }
}
